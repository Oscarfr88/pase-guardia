{
  "name": "pase-guardia",
  "private": true,
  "version": "0.2.0",
  "description": "PWA personal para dictar y estructurar el pase de guardia en Terapia Intensiva. Todo en el dispositivo.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && tsc -p tsconfig.sw.json && vite build",
