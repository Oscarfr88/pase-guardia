    "test": "vitest run",
    "test:watch": "vitest",
    "icons": "node scripts/gen-icons.mjs",
    "modelos": "node scripts/obtener-modelos.mjs",
    "verificar": "node scripts/verificar-repo.mjs && node scripts/verificar-tamano.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "5.3.0",
    "@huggingface/transformers": "4.3.2",
    "lucide-react": "1.78.0",
    "onnxruntime-web": "1.31.0-dev.20260914-8d85527a0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/react": "18.3.31",
    "@types/react-dom": "18.3.7",
    "@vitejs/plugin-react": "6.3.0",
    "autoprefixer": "10.7.0",
    "postcss": "8.5.33",
    "sharp": "0.35.5",
    "tailwindcss": "3.4.19",
    "typescript": "5.9.3",
    "vite": "8.3.8",
    "vite-plugin-pwa": "2.0.0",
    "vitest": "5.1.1",
    "workbox-build": "7.4.1",
    "workbox-precaching": "7.4.1",
